# PII Review desktop settings. The Settings menu sets the language, the local
# model, and where the models run; for the rest, uncomment a line here and
# change it. Then choose Settings > Restart Engine (Ctrl+Shift+R, or
# Shift+Cmd+R on a Mac). Every setting has a default; see .env.example in the
# source repository.

# Language when detection is off or undecided: en, de, or fr.
#PII_REVIEW_LANGUAGE=en

# Where the text is analysed. Empty (default): the spaCy analyzer built into
# the app. Or a Presidio analyzer elsewhere, with another NLP engine: for
# example the repository's transformers image, on this computer:
#   docker compose build presidio-analyzer-transformers   (COMPOSE_PROFILES=transformers)
#   docker run --rm -p 127.0.0.1:5002:3000 --read-only --tmpfs /tmp pii-review-presidio-analyzer:2.2.362-2-transformers
# The text is sent to it UNMASKED: use one on this computer or a private
# network. The app then loads no language models of its own.
#PII_REVIEW_ANALYZER_URL=http://127.0.0.1:5002

# Optional local model that detects each text's language and personal data
# Presidio misses, through any OpenAI-compatible API. The text is sent to it
# UNMASKED: use a model on this computer or a private network, never a cloud API.
#   Ollama on this computer:
#PII_REVIEW_ASSIST_URL=http://127.0.0.1:11434/v1
#PII_REVIEW_ASSIST_MODEL=qwen3.5:4b
#   A LiteLLM gateway's pii-assist model, with a key limited to that model:
#PII_REVIEW_ASSIST_URL=https://litellm.example.test/v1
#PII_REVIEW_ASSIST_MODEL=pii-assist
#PII_REVIEW_ASSIST_KEY=sk-...
#PII_REVIEW_ASSIST_MAX_CALLS=8

# Largest upload (default 200 MiB) and the most text one analysis covers.
#PII_REVIEW_MAX_FILE_BYTES=209715200
#PII_REVIEW_MAX_TEXT_BYTES=250000000
# Seconds the document reader may take for one document (10-7200).
#PII_REVIEW_XBERG_TIMEOUT_SECONDS=1800

# Where the language models run. auto (default): on Windows and Linux x64, if
# the computer has an NVIDIA GPU, the app downloads GPU support once (about
# 850 MB, from PyPI) and from then on runs the models on the GPU when it works.
# cpu: never download or use GPU support.
#PII_REVIEW_DEVICE=auto

# Require a LiteLLM virtual key, checked by these gateways, instead of letting
# whoever runs the app use it directly.
#PII_REVIEW_GATEWAYS=https://litellm.example.test
