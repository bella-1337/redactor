# Copy to .env and adjust. Every setting except PII_REVIEW_GATEWAYS has a default.

# Presidio's NLP engine, as a compose profile; choose one:
#   spacy         spaCy pipelines for English, German, and French (default)
#   transformers  Presidio's Transformers engine with a multilingual Hugging
#                 Face NER model, on the CPU: often better at names, slower, and
#                 a larger image (PyTorch and the model, built in)
# Without a profile no analyzer starts.
COMPOSE_PROFILES=spacy
# transformers only: the NER model and the commit of it the image builds in.
# A branch resolves to its commit at build time; the build prints it. Pin that
# commit here for builds that give the same model every time.
#PRESIDIO_HF_MODEL=Davlan/xlm-roberta-base-ner-hrl
#PRESIDIO_HF_MODEL_REVISION=main

# LiteLLM gateways that check users' virtual keys (GET /v1/models). A key any of
# them accepts may use the page. https URLs are verified against the system's
# CA certificates; plain http is for gateways on this host or a private network.
PII_REVIEW_GATEWAYS=https://litellm.example.test

# Where the page listens. Keep 127.0.0.1 and put a TLS reverse proxy in front to
# offer it to other people.
PII_REVIEW_BIND=127.0.0.1
PII_REVIEW_PORT=8080

# Optional local model that detects each text's language (en, de, fr) and the
# personal data in it, through any OpenAI-compatible API. The text is sent
# unmasked, so use a model on this host or a private network, never a cloud API.
#   A LiteLLM gateway's pii-assist model, with a key limited to that model:
#     PII_REVIEW_ASSIST_URL=https://litellm.example.test/v1
#     PII_REVIEW_ASSIST_MODEL=pii-assist
#     PII_REVIEW_ASSIST_KEY=sk-...
#   Ollama on the Docker host, no key:
#     PII_REVIEW_ASSIST_URL=http://host.docker.internal:11434/v1
#     PII_REVIEW_ASSIST_MODEL=qwen3.5:4b
# Empty: Presidio alone, in PII_REVIEW_LANGUAGE.
PII_REVIEW_ASSIST_URL=
PII_REVIEW_ASSIST_MODEL=pii-assist
PII_REVIEW_ASSIST_KEY=
# Model calls per analysis, 4000 characters each (1-30). Text beyond them is
# still analysed by Presidio.
PII_REVIEW_ASSIST_MAX_CALLS=8

# Language when detection is off or undecided: en, de, or fr.
PII_REVIEW_LANGUAGE=en
# Largest upload (default 200 MiB, at most 250000000 bytes) and the most text
# one analysis covers (default and maximum 250000000 bytes). All of a
# document's text is analysed, in 100 KB pieces; large texts take minutes.
PII_REVIEW_MAX_FILE_BYTES=209715200
PII_REVIEW_MAX_TEXT_BYTES=250000000
# Seconds Xberg may take to read one document (10-7200).
PII_REVIEW_XBERG_TIMEOUT_SECONDS=1800
# Analyse and mask requests per key per minute.
PII_REVIEW_REQUESTS_PER_MINUTE=30

# Resource limits.
PII_REVIEW_CPU_LIMIT=2
PII_REVIEW_MEMORY_LIMIT=3g
# Analyzer workers; one analysis uses all of them in parallel (about 0.1 GiB each,
# the pipelines are shared). More workers analyse large texts faster.
PRESIDIO_ANALYZER_WORKERS=2
PRESIDIO_ANALYZER_CPU_LIMIT=2
PRESIDIO_ANALYZER_MEMORY_LIMIT=4g
# The transformers analyzer loads its model once per language.
PRESIDIO_TRANSFORMERS_MEMORY_LIMIT=6g
PRESIDIO_ANONYMIZER_WORKERS=2
XBERG_CPU_LIMIT=2
XBERG_MEMORY_LIMIT=4g
XBERG_TMP_SIZE=1g
