# CuPy and the CUDA 12 libraries the spaCy pipelines need on an NVIDIA GPU
# (runtime, NVRTC for thinc's kernels, cuBLAS, cuRAND), installed only when the
# analyzer is built with GPU=true (compose.gpu.yml). Installed without
# dependencies: the image's own numpy (2.x) is kept. x86_64 only. Compile with
#   uv pip compile gpu-requirements.in --no-deps --python-version 3.12 \
#     --python-platform x86_64-unknown-linux-gnu --generate-hashes --no-header \
#     -o gpu-requirements.txt
# and keep the versions in step with desktop/runtime/requirements.in.
cupy-cuda12x==14.2.0
cuda-pathfinder==1.9.1
nvidia-cuda-runtime-cu12==12.9.79
nvidia-cuda-nvrtc-cu12==12.9.86
nvidia-cublas-cu12==12.9.2.10
nvidia-curand-cu12==10.3.10.19
